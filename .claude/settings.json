{
  "permissions": {
    "allow": [
      "Bash(curl -s *)",
      "Bash(npm list *)",
      "Bash(openclaw doctor *)",
      "Bash(openclaw skills *)",
      "Bash(openclaw sandbox *)",
      "Bash(openclaw config *)",
      "Bash(openclaw --version)",
      "Bash(openclaw --help)"
    ],
    "deny": [
      "Bash(* --submit *)",
      "Bash(git add .local/*)",
      "Bash(git add */\.local/*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/parker2017/tn12-covenant-vault-demo/.claude/hooks/check-submit-guard.sh"
          }
        ]
      }
    ]
  }
}
