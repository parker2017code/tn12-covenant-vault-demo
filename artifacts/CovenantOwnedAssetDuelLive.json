    "span": "contract CovenantOwnedAssetDuel(byte[32] initOwnerCovenantId, int initPower) {\n    byte[32] ownerCovenantId = initOwnerCovenantId;\n    int power = initPower;\n\n    entrypoint function strike(int witnessInput, byte[32] nextOwnerCovenantId, int spendPower) {\n        require(spendPower > 0);\n        require(spendPower <= power);\n        require(OpInputCovenantId(witnessInput) == ownerCovenantId);\n        require(OpAuthOutputCount(this.activeInputIndex) == 1);\n\n        int output_idx = OpAuthOutputIdx(this.activeInputIndex, 0);\n        State nextState = {\n            ownerCovenantId: nextOwnerCovenantId,\n            power: power - spendPower\n        };\n        validateOutputState(output_idx, nextState);\n    }\n}",
