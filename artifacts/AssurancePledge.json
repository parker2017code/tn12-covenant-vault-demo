    "span": "contract AssurancePledge(\n    pubkey contributor,\n    pubkey recipient,\n    int deadline,\n    int minerFee\n) {\n    entrypoint function release() {\n        // Target/deadline aggregation is enforced by the planner; this pledge\n        // primitive only carries the recipient release and contributor refund paths.\n\n        int amount = tx.inputs[this.activeInputIndex].value - minerFee;\n        require(tx.outputs[0].value == amount);\n\n        byte[34] recipientLock = new ScriptPubKeyP2PK(recipient);\n        require(tx.outputs[0].scriptPubKey == byte[](recipientLock));\n    }\n\n    entrypoint function refund(sig contributorSig) {\n        require(checkSig(contributorSig, contributor));\n        require(tx.time >= deadline);\n\n        int amount = tx.inputs[this.activeInputIndex].value - minerFee;\n        require(tx.outputs[0].value == amount);\n\n        byte[34] contributorLock = new ScriptPubKeyP2PK(contributor);\n        require(tx.outputs[0].scriptPubKey == byte[](contributorLock));\n    }\n}",
