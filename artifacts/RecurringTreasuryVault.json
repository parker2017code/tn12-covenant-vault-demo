        "return_type_spans": [],
        "span": "#[covenant.singleton]\n    function spend(State prevState, State newState, sig ownerSig, int amount) {\n        require(checkSig(ownerSig, owner));\n        require(amount > 0);\n        require(prevState.spent + amount <= cap);\n        require(newState.spent == prevState.spent + amount);\n        require(newState.window == prevState.window);\n\n        int inputValue = tx.inputs[this.activeInputIndex].value;\n        int changeValue = inputValue - amount - minerFee;\n        require(changeValue > 0);\n\n        byte[34] destinationLock = new ScriptPubKeyP2PK(destination);\n        require(tx.outputs[0].scriptPubKey == byte[](destinationLock));\n        require(tx.outputs[0].value == amount);\n\n        validateOutputState(1, newState);\n        require(tx.outputs[1].value == changeValue);\n    }",
        "name_span": "spend",
        "body_span": "require(checkSig(ownerSig, owner));\n        require(amount > 0);\n        require(prevState.spent + amount <= cap);\n        require(newState.spent == prevState.spent + amount);\n        require(newState.window == prevState.window);\n\n        int inputValue = tx.inputs[this.activeInputIndex].value;\n        int changeValue = inputValue - amount - minerFee;\n        require(changeValue > 0);\n\n        byte[34] destinationLock = new ScriptPubKeyP2PK(destination);\n        require(tx.outputs[0].scriptPubKey == byte[](destinationLock));\n        require(tx.outputs[0].value == amount);\n\n        validateOutputState(1, newState);\n        require(tx.outputs[1].value == changeValue);"
      },
