  "systemArchitecture": {
    "claude-code": {
      "role": "Orchestrator",
      "responsibilities": [
        "Receive settlement request (escrow/batch-assurance/auction)",
        "Build unsigned covenant drafts",
        "Delegate to external signer (OpenClaw KasWare or local sim)",
        "Assemble and submit signed drafts",
        "Track TN12 acceptance"
      ],
      "tools": [
        "Read/Write (local artifacts)",
        "Bash (npm scripts for covenant/draft building)",
        "WebSearch (TN12 testnet status)",
        "Agent (spawn Codex for parallel bid validation)"
      ]
    },
    "codex": {
      "role": "Parallel worker",
      "responsibilities": [
        "Validate bid amounts against reserve",
        "Audit role-key assignments",
        "Review settlement output splitting",
        "Generate settlement decision artifacts"
      ],
      "trigger": "openclaw coding-agent skill"
    },
    "openclaw": {
      "role": "External signer gateway",
      "responsibilities": [
        "Drive KasWare for wallet signing",
        "Fall back to local sim if wallet unavailable",
        "Return signature bytes to Claude"
      ],
      "skill": "tn12-kaswore-signer"
    }
  },

  "orchestrationFlows": [
    {
      "flowName": "Escrow Release (happy path)",
      "actors": ["claude-code", "openclaw (kaswore)", "tn12-node"],
      "steps": [
        {
          "step": 1,
          "actor": "claude-code",
          "action": "Read escrow UTXO and settlement parameters",
          "input": "artifacts/escrow-marketplace-action-map.json",
          "output": "escrow state loaded"
        },
        {
          "step": 2,
          "actor": "claude-code",
          "action": "Build unsigned covenant spend draft",
          "input": "escrow UTXO, settlement role addresses",
          "output": "artifacts/unsigned-drafts/escrow-release.json"
        },
        {
          "step": 3,
          "actor": "openclaw (kaswore)",
          "action": "Sign covenant spend with KasWare",
          "input": "unsigned draft",
          "output": "signature bytes + signed tx"
        },
        {
          "step": 4,
          "actor": "claude-code",
          "action": "Assemble final signed draft",
          "input": "unsigned + signature",
          "output": "artifacts/signed-drafts/escrow-release.json"
        },
        {
          "step": 5,
          "actor": "claude-code",
          "action": "Submit via TN12 wRPC endpoint",
          "input": "signed draft, KASPA_WRPC_URL",
          "output": "txid, accepting block blue score"
        },
        {
          "step": 6,
          "actor": "claude-code",
          "action": "Record settlement acceptance",
          "input": "txid from step 5",
          "output": "artifacts/settlement-acceptance-log.json"
        }
      ],
      "successCriteria": [
        "Draft txid matches expected fingerprint",
        "Signature preserved through roundtrip",
        "Submit returns accepted txid",
        "Role-separated outputs confirmed in DAG"
      ],
      "fallback": [
        "If KasWare unavailable: use local sim (status: sim-validated)",
        "If TN12 endpoint down: queue for replay (status: signed-not-broadcast)",
        "If signature mismatch: trigger MPC recovery flow"
      ]
    },
    {
      "flowName": "Batch-Assurance Settlement (parallel release + refunds)",
      "actors": ["claude-code", "codex (parallel validation)", "openclaw"],
      "steps": [
        {
          "step": 1,
          "actor": "codex",
          "action": "Validate pledge outputs against custody imports",
          "input": "batch custody drafts",
          "output": "validation report (concurrent)"
        },
        {
          "step": 2,
          "actor": "claude-code",
          "action": "Build release + N refund drafts in parallel",
          "input": "custody validation + pledge wallets",
          "output": "N+1 unsigned drafts"
        },
        {
          "step": 3,
          "actor": "openclaw",
          "action": "Sign each draft batch",
          "input": "N+1 unsigned drafts",
          "output": "N+1 signatures (parallel)"
        },
        {
          "step": 4,
          "actor": "claude-code",
          "action": "Assemble signed drafts",
          "input": "unsigned + signatures",
          "output": "signed-drafts/"
        },
        {
          "step": 5,
          "actor": "claude-code",
          "action": "Submit mutually exclusive path (release OR all refunds)",
          "input": "one settlement path chosen",
          "output": "txid for release -or- N txids for refunds"
        }
      ],
      "concurrency": {
        "validation": "Codex validates while Claude builds drafts",
        "signing": "OpenClaw signs multiple drafts in batch",
        "submission": "Sequential (mutual exclusivity enforced)"
      }
    },
    {
      "flowName": "Auction Settlement (with OpenClaw fallback to sim)",
      "actors": ["claude-code", "openclaw (kaswore fallback)", "tn12-node"],
      "steps": [
        {
          "step": 1,
          "actor": "claude-code",
          "action": "Build unsigned auction settlement covenant spend",
          "input": "highest-bid UTXO, seller/buyer addresses",
          "output": "unsigned-drafts/auction-settlement.json"
        },
        {
          "step": 2,
          "actor": "openclaw",
          "action": "Try KasWare signing; fall back to sim if unavailable",
          "input": "unsigned draft",
          "fallback": {
            "condition": "KasWare unavailable or timeout > 30s",
            "action": "Use buildWalletExternalSignerSim()",
            "status": "sim-validated (not-broadcast)"
          },
          "output": "signature -or- sim-validated status"
        },
        {
          "step": 3,
          "actor": "claude-code",
          "action": "Check signature source (live vs sim)",
          "input": "signature origin",
          "decision": "if live-signed → submit now; if sim-validated → queue for manual approval"
        },
        {
          "step": 4,
          "actor": "claude-code (or operator)",
          "action": "Submit settlement spend to TN12",
          "input": "signed draft (live-signed only)",
          "output": "txid + acceptance confirmation"
        }
      ],
      "fallbackPath": {
        "trigger": "KasWare unavailable or timeout",
        "action": "Generate sim-validated artifact",
        "output": "artifacts/auction-settlement-sim-validated.json",
        "status": "ready-for-manual-signing",
        "nextStep": "User loads artifact in KasWare manually when wallet available"
      }
    }
  ],

