    "span": "contract BlitzWorkerA(byte[32] init_mux_template, byte[32] init_a_template, byte[32] init_b_template, int init_value, int init_timeout, int init_pending) {\n    byte[32] mux_template = init_mux_template;\n    byte[32] a_template = init_a_template;\n    byte[32] b_template = init_b_template;\n\n    int value = init_value;\n    int move_timeout = init_timeout;\n    int pending = init_pending;\n\n    entrypoint function apply(int reward, byte[] mux_prefix, byte[] mux_suffix) {\n        require(pending == 1);\n        require(reward > 0);\n        require(reward < 10);\n        require(OpAuthOutputCount(this.activeInputIndex) == 1);\n        int output_idx = OpAuthOutputIdx(this.activeInputIndex, 0);\n\n        State state = {\n            mux_template: mux_template,\n            a_template: a_template,\n            b_template: b_template,\n            value: value + reward,\n            move_timeout: move_timeout,\n            pending: 0\n        };\n        validateOutputStateWithTemplate(output_idx, state, mux_prefix, mux_suffix, mux_template);\n    }\n\n    entrypoint function timeout(byte[] mux_prefix, byte[] mux_suffix) {\n        require(pending == 1);\n        require(this.age >= move_timeout);\n        require(OpAuthOutputCount(this.activeInputIndex) == 1);\n        int output_idx = OpAuthOutputIdx(this.activeInputIndex, 0);\n\n        State state = {\n            mux_template: mux_template,\n            a_template: a_template,\n            b_template: b_template,\n            value: value - 1,\n            move_timeout: move_timeout,\n            pending: 0\n        };\n        validateOutputStateWithTemplate(output_idx, state, mux_prefix, mux_suffix, mux_template);\n    }\n}",
