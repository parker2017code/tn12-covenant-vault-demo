        "span": "entrypoint function route(int selector, byte[] target_prefix, byte[] target_suffix) {\n        require(pending == 0);\n        require(OpAuthOutputCount(this.activeInputIndex) == 1);\n        int output_idx = OpAuthOutputIdx(this.activeInputIndex, 0);\n\n        byte[32] target_template = a_template;\n        int next_pending = 1;\n        if (selector != 0) {\n            require(selector == 1);\n            target_template = b_template;\n            next_pending = 2;\n        }\n\n        State state = {\n            mux_template: mux_template,\n            a_template: a_template,\n            b_template: b_template,\n            value: value,\n            move_timeout: move_timeout,\n            pending: next_pending\n        };\n        validateOutputStateWithTemplate(output_idx, state, target_prefix, target_suffix, target_template);\n    }",
        "name_span": "route",
        "body_span": "require(pending == 0);\n        require(OpAuthOutputCount(this.activeInputIndex) == 1);\n        int output_idx = OpAuthOutputIdx(this.activeInputIndex, 0);\n\n        byte[32] target_template = a_template;\n        int next_pending = 1;\n        if (selector != 0) {\n            require(selector == 1);\n            target_template = b_template;\n            next_pending = 2;\n        }\n\n        State state = {\n            mux_template: mux_template,\n            a_template: a_template,\n            b_template: b_template,\n            value: value,\n            move_timeout: move_timeout,\n            pending: next_pending\n        };\n        validateOutputStateWithTemplate(output_idx, state, target_prefix, target_suffix, target_template);"
