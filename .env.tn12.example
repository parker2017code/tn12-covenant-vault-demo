# TN12 endpoint sample
# Copy to .env.tn12 locally if you need a shell-friendly default.

KASPA_WRPC_URL=ws://tn12-node.kaspa.com:17210
KASPA_WRPC_ENCODING=borsh

# Optional local-only override for a TN12/Toccata wasm build.
# Leave unset unless you have built one locally.
# KASPA_WASM_MODULE=/absolute/path/to/rusty-kaspa/wasm/nodejs/kaspa
